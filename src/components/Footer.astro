---
import type { Locale } from '../i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'fr' } = Astro.props;
---

<footer class="border-t border-border bg-background/80">
  <div class="container mx-auto flex flex-col items-center justify-between gap-4 px-4 py-6 text-sm text-muted md:flex-row">
    <p class="flex flex-wrap items-center justify-center gap-x-2 gap-y-1 text-center md:justify-start md:text-left">
      <span>© <span id="current-year">2026</span>  Baseme Habajuwe Sammy. {locale === 'fr' ? 'Tous droits réservés.' : 'All rights reserved.'}</span>
      <a
        href="https://wa.me/243974791666"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 font-medium text-[#25D366] hover:underline"
        aria-label={locale === 'fr' ? 'Contacter sur WhatsApp au +243 974 791 666' : 'Contact on WhatsApp at +243 974 791 666'}
      >
        <svg viewBox="0 0 32 32" class="h-5 w-5" fill="currentColor" aria-hidden="true">
          <path d="M16 .8A15.1 15.1 0 0 0 3.05 23.66L1 31l7.52-1.97A15.1 15.1 0 1 0 16 .8Zm0 27.45a12.3 12.3 0 0 1-6.27-1.72l-.45-.27-4.46 1.17 1.2-4.35-.3-.47A12.32 12.32 0 1 1 16 28.25Zm6.76-9.22c-.37-.19-2.2-1.09-2.54-1.22-.34-.12-.59-.18-.84.19-.25.37-.96 1.22-1.18 1.47-.22.25-.44.28-.81.09-.37-.19-1.56-.57-2.97-1.83-1.1-.98-1.85-2.2-2.07-2.57-.22-.37-.02-.57.17-.76.17-.17.37-.44.56-.66.18-.22.25-.37.37-.62.12-.25.06-.47-.03-.66-.09-.19-.84-2.03-1.15-2.78-.3-.73-.61-.63-.84-.64h-.72c-.25 0-.66.09-1 .47-.34.37-1.31 1.28-1.31 3.12s1.34 3.62 1.53 3.87c.19.25 2.64 4.03 6.4 5.65.9.39 1.6.62 2.15.8.9.28 1.72.24 2.37.15.72-.11 2.2-.9 2.51-1.78.31-.87.31-1.62.22-1.78-.09-.15-.34-.25-.72-.44Z"/>
        </svg>
        <span>+243 974 791 666</span>
      </a>
    </p>
    <div class="flex items-center gap-4">
      <a href="mailto:basemehabajuwe3@gmail.com" class="hover:text-primary">Email</a>
      <a href="https://github.com/basemehabajuwe3-cmyk" target="_blank" rel="noreferrer" class="hover:text-primary">GitHub</a>
      <a href="https://www.linkedin.com/in/samy-baseme-aa16ba259/" target="_blank" rel="noopener noreferrer" class="hover:text-primary">LinkedIn</a>
    </div>
  </div>
</footer>

<script>
  const yearNode = document.getElementById('current-year');
  if (yearNode) {
    yearNode.textContent = String(new Date().getFullYear());
  }
</script>
