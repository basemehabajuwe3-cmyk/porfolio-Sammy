---
import { getLocalizedPath, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const alternateLocale = locale === 'fr' ? 'en' : 'fr';
const alternatePath = getLocalizedPath(Astro.url.pathname, alternateLocale);
---
<div class="inline-flex items-center rounded-full border border-border bg-background/80 p-1 shadow-sm">
  <a
    href={locale === 'fr' ? Astro.url.pathname : alternatePath}
    lang="fr"
    aria-current={locale === 'fr' ? 'page' : undefined}
    class:list={[
      'rounded-full px-2.5 py-1 text-xs font-semibold transition-colors',
      locale === 'fr' ? 'bg-primary text-white' : 'text-muted hover:text-primary',
    ]}
  >FR</a>
  <a
    href={locale === 'en' ? Astro.url.pathname : alternatePath}
    lang="en"
    aria-current={locale === 'en' ? 'page' : undefined}
    class:list={[
      'rounded-full px-2.5 py-1 text-xs font-semibold transition-colors',
      locale === 'en' ? 'bg-primary text-white' : 'text-muted hover:text-primary',
    ]}
  >EN</a>
</div>
