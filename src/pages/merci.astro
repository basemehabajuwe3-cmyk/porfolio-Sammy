---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Message envoyé | Sammy Habajuwe"
  description="Merci pour votre message. Sammy Habajuwe vous répondra dès que possible."
>
  <section class="container mx-auto px-4 py-20 md:py-28">
    <div class="mx-auto max-w-2xl rounded-3xl border border-border bg-card p-8 text-center shadow-sm md:p-12">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-primary">Merci</p>
      <h1 class="mt-3 text-3xl font-black text-foreground md:text-4xl">Votre message a bien été envoyé.</h1>
      <p class="mt-4 leading-7 text-muted">Merci de m’avoir contacté. Je vous répondrai dès que possible.</p>
      <a href="/" class="mt-8 inline-flex rounded-lg bg-primary px-5 py-3 text-sm font-semibold text-white transition hover:bg-primary/90">
        Retour à l’accueil
      </a>
    </div>
  </section>
</Layout>
