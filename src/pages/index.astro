---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
import { skillGroups } from '../data/skills';

const featuredProjects = projects.slice(0, 3);
---

<Layout
  title="Baseme Habajuwe Sammy| Développeur Full Stack"
  description="Portfolio de Baseme Habajuwe, développeur full stack et frontend basé à Goma. Applications web modernes, rapides et centrées utilisateur."
>
  <section class="container mx-auto px-4 py-20 md:py-28">
    <div class="grid items-center gap-10 md:grid-cols-[1.1fr_0.9fr]">
      <div class="space-y-6 text-center md:text-left">
        <span class="inline-flex rounded-full border border-primary/20 bg-primary/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.2em] text-primary">
          Disponible pour missions
        </span>
        <div class="space-y-4">
          <h1 class="text-4xl font-black tracking-tight text-foreground md:text-6xl">
            Baseme Habajuwe
          </h1>
          <p class="text-xl text-muted md:text-2xl">Développeur Full Stack & Frontend</p>
          <p class="max-w-xl text-base leading-7 text-muted md:text-lg">
            Diplômé en Informatique et Gestion et développeur web, je conçois des sites et applications adaptés aux besoins des utilisateurs. Mon expérience en développement, journalisme et coordination de projets communautaires m’a apporté rigueur, sens de la communication et esprit d’initiative.
          </p>
        </div>

        <div class="flex flex-col justify-center gap-4 sm:flex-row md:justify-start">
          <a
            href="/projets"
            class="inline-flex items-center justify-center rounded-lg bg-primary px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-primary/90"
          >
            Voir mes projets
          </a>
          <a
            href="/contact"
            class="inline-flex items-center justify-center rounded-lg border border-border bg-card px-6 py-3 text-sm font-semibold text-foreground transition hover:border-primary hover:text-primary"
          >
            Travailler ensemble
          </a>
        </div>
      </div>

      <div class="flex justify-center md:justify-end">
        <div class="relative">
          <div class="absolute -inset-3 rounded-full bg-primary/20 blur-2xl"></div>
          <img
            src="/images/profil.jpg"
            alt="Portrait de Baseme Habajuwe"
            width="320"
            height="320"
            class="relative h-64 w-64 rounded-full border-4 border-white object-cover shadow-2xl md:h-80 md:w-80 dark:border-slate-900"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="container mx-auto px-4 pb-12">
    <div class="grid gap-4 md:grid-cols-3">
      <div class="rounded-2xl border border-border bg-card p-5 shadow-sm">
        <p class="text-sm text-muted">Expérience</p>
        <p class="mt-3 text-3xl font-bold text-foreground">1+</p>
        <p class="mt-1 text-sm text-muted">an d’expérience</p>
      </div>
      <div class="rounded-2xl border border-border bg-card p-5 shadow-sm">
        <p class="text-sm text-muted">Projets</p>
        <p class="mt-3 text-3xl font-bold text-foreground">4</p>
        <p class="mt-1 text-sm text-muted">3 projets + mon portfolio, d’autres en cours</p>
      </div>
      <div class="rounded-2xl border border-border bg-card p-5 shadow-sm">
        <p class="text-sm text-muted">Approche</p>
        <p class="mt-3 text-3xl font-bold text-foreground">UX</p>
        <p class="mt-1 text-sm text-muted">centrée sur le business</p>
      </div>
    </div>
  </section>

  <section class="container mx-auto px-4 py-16">
    <div class="mb-10 text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-primary">Compétences</p>
      <h2 class="mt-3 text-3xl font-bold text-foreground md:text-4xl">Ce que je maîtrise</h2>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
      {skillGroups.map((group) => (
        <div class="rounded-2xl border border-border bg-card p-6 shadow-sm">
          <h3 class="mb-4 text-xl font-semibold text-foreground">{group.title}</h3>
          <div class="flex flex-wrap gap-2">
            {group.items.map((item) => (
              <span class="rounded-full border border-border bg-background px-3 py-1.5 text-sm text-muted">{item}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section id="projets" class="container mx-auto px-4 py-16">
    <div class="mb-10 flex items-end justify-between gap-4">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-primary">Portfolio</p>
        <h2 class="mt-3 text-3xl font-bold text-foreground md:text-4xl">Mes projets phares</h2>
      </div>
      <a href="/projets" class="hidden text-sm font-semibold text-primary hover:underline md:inline-flex">Voir tout</a>
    </div>

    <div class="grid gap-8 md:grid-cols-2 xl:grid-cols-3">
      {featuredProjects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </section>
</Layout>
