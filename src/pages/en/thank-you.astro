---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  locale="en"
  title="Message sent | Sammy Habajuwe"
  description="Thank you for your message. Sammy Habajuwe will get back to you as soon as possible."
>
  <section class="container mx-auto px-4 py-20 md:py-28">
    <div class="mx-auto max-w-2xl rounded-3xl border border-border bg-card p-8 text-center shadow-sm md:p-12">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-primary">Thank you</p>
      <h1 class="mt-3 text-3xl font-black text-foreground md:text-4xl">Your message has been sent.</h1>
      <p class="mt-4 leading-7 text-muted">Thanks for reaching out. I’ll get back to you as soon as I can.</p>
      <a href="/en/" class="mt-8 inline-flex rounded-lg bg-primary px-5 py-3 text-sm font-semibold text-white transition hover:bg-primary/90">
        Back to home
      </a>
    </div>
  </section>
</Layout>
