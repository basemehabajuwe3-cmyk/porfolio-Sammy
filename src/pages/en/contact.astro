---
import Layout from '../../layouts/Layout.astro';
import ContactForm from '../../components/ContactForm.astro';
import { formspreeEndpoints } from '../../lib/formspree';
---

<Layout
  title="Contact | Sammy Habajuwe"
  description="Contact Sammy Habajuwe about a project, collaboration, or web development opportunity."
  locale="en"
>
  <section class="container mx-auto px-4 py-20 md:py-24">
    <div class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-stretch">
      <div class="rounded-3xl border border-border bg-card p-6 shadow-sm md:p-8">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-primary">Contact</p>
        <h1 class="mt-3 text-3xl font-black text-foreground md:text-4xl">Let’s talk about your project.</h1>
        <p class="mt-4 leading-7 text-muted">
          Are you a client, recruiter, or potential collaborator? Tell me what you have in mind and we can find the best way to connect.
        </p>
        <div class="mt-7 space-y-3">
          <a href="mailto:basemehabajuwe3@gmail.com" class="flex min-w-0 items-center gap-4 rounded-2xl bg-primary/10 p-4 text-foreground hover:bg-primary/15">
            <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-primary text-white">✉</span>
            <span class="min-w-0"><span class="mb-1 block text-xs font-medium uppercase tracking-wide text-muted">Email</span><span class="break-all font-semibold">basemehabajuwe3@gmail.com</span></span>
          </a>
          <div class="grid gap-3 sm:grid-cols-2">
            <a href="tel:+243974791666" class="flex items-center gap-3 rounded-2xl border border-border p-4 text-foreground hover:border-primary">
              <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-background text-primary">☎</span>
              <span><span class="mb-1 block text-xs font-medium text-muted">Phone</span><span class="font-semibold">+243 974 791 666</span></span>
            </a>
            <a href="tel:+243850160497" class="flex items-center gap-3 rounded-2xl border border-border p-4 text-foreground hover:border-primary">
              <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-background text-primary">☎</span>
              <span><span class="mb-1 block text-xs font-medium text-muted">Phone</span><span class="font-semibold">+243 850 160 497</span></span>
            </a>
          </div>
        </div>
        <a href="https://share.google/GWQKiFUnufZwP5VlX" target="_blank" rel="noopener noreferrer" class="mt-3 flex items-start gap-4 rounded-2xl border border-border p-4 text-foreground transition hover:border-primary">
          <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-background text-primary">⌖</span>
          <span><span class="mb-1 block text-xs font-medium uppercase tracking-wide text-muted">Location</span><span class="font-medium">Idjwi / Bugarula, South Kivu, Bukavu, Democratic Republic of the Congo</span></span>
        </a>
        <div class="mt-6 flex flex-wrap gap-3 border-t border-border pt-5">
          <a href="https://github.com/basemehabajuwe3-cmyk" target="_blank" rel="noreferrer" class="rounded-lg border border-border px-4 py-2 text-sm font-semibold text-foreground hover:border-primary hover:text-primary">GitHub ↗</a>
          <a href="https://www.linkedin.com/in/samy-baseme-aa16ba259/" target="_blank" rel="noopener noreferrer" class="rounded-lg border border-border px-4 py-2 text-sm font-semibold text-foreground hover:border-primary hover:text-primary">LinkedIn ↗</a>
        </div>
      </div>

      <ContactForm locale="en" endpoint={formspreeEndpoints.en} />
    </div>
  </section>
</Layout>
