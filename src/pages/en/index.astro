---
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects } from '../../data/projects';
import { skillGroups } from '../../data/skills';

const featuredProjects = projects.slice(0, 3);
const skillTitles: Record<string, string> = {
  Frontend: 'Frontend',
  Backend: 'Backend',
  'Outils & workflow': 'Tools & workflow',
};
---

<Layout
  title="Sammy Habajuwe | Full Stack Developer"
  description="Portfolio of Sammy Habajuwe, a full stack and frontend developer based in Goma. Modern, fast, user-focused web applications."
  locale="en"
>
  <section class="container mx-auto px-4 py-20 md:py-28">
    <div class="grid items-center gap-10 md:grid-cols-[1.1fr_0.9fr]">
      <div class="space-y-6 text-center md:text-left">
        <span class="inline-flex rounded-full border border-primary/20 bg-primary/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.2em] text-primary">
          Available for projects
        </span>
        <div class="space-y-4">
          <h1 class="text-4xl font-black tracking-tight text-foreground md:text-6xl">Sammy Habajuwe</h1>
          <p class="text-xl text-muted md:text-2xl">Full Stack & Frontend Developer</p>
          <p class="max-w-xl text-base leading-7 text-muted md:text-lg">
            I build clear, fast, and easy-to-use digital products for businesses that want to grow without friction.
          </p>
        </div>

        <div class="flex flex-col justify-center gap-4 sm:flex-row md:justify-start">
          <a href="/en/projects" class="inline-flex items-center justify-center rounded-lg bg-primary px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-primary/90">
            View my projects
          </a>
          <a href="/en/contact" class="inline-flex items-center justify-center rounded-lg border border-border bg-card px-6 py-3 text-sm font-semibold text-foreground transition hover:border-primary hover:text-primary">
            Let’s work together
          </a>
        </div>
      </div>

      <div class="flex justify-center md:justify-end">
        <div class="relative">
          <div class="absolute -inset-3 rounded-full bg-primary/20 blur-2xl"></div>
          <img src="/images/photo-profil.svg" alt="Portrait of Sammy Habajuwe" width="320" height="320" class="relative h-64 w-64 rounded-full border-4 border-white object-cover shadow-2xl md:h-80 md:w-80 dark:border-slate-900" />
        </div>
      </div>
    </div>
  </section>

  <section class="container mx-auto px-4 pb-12">
    <div class="grid gap-4 md:grid-cols-3">
      <div class="rounded-2xl border border-border bg-card p-5 shadow-sm"><p class="text-sm text-muted">Experience</p><p class="mt-3 text-3xl font-bold text-foreground">5+</p><p class="mt-1 text-sm text-muted">years building for the web</p></div>
      <div class="rounded-2xl border border-border bg-card p-5 shadow-sm"><p class="text-sm text-muted">Projects</p><p class="mt-3 text-3xl font-bold text-foreground">18</p><p class="mt-1 text-sm text-muted">applications delivered</p></div>
      <div class="rounded-2xl border border-border bg-card p-5 shadow-sm"><p class="text-sm text-muted">Approach</p><p class="mt-3 text-3xl font-bold text-foreground">UX</p><p class="mt-1 text-sm text-muted">focused on business outcomes</p></div>
    </div>
  </section>

  <section class="container mx-auto px-4 py-16">
    <div class="mb-10 text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-primary">Skills</p>
      <h2 class="mt-3 text-3xl font-bold text-foreground md:text-4xl">What I do best</h2>
    </div>
    <div class="grid gap-6 md:grid-cols-3">
      {skillGroups.map((group) => (
        <div class="rounded-2xl border border-border bg-card p-6 shadow-sm">
          <h3 class="mb-4 text-xl font-semibold text-foreground">{skillTitles[group.title] ?? group.title}</h3>
          <div class="flex flex-wrap gap-2">
            {group.items.map((item) => <span class="rounded-full border border-border bg-background px-3 py-1.5 text-sm text-muted">{item}</span>)}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section id="projects" class="container mx-auto px-4 py-16">
    <div class="mb-10 flex items-end justify-between gap-4">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-primary">Portfolio</p>
        <h2 class="mt-3 text-3xl font-bold text-foreground md:text-4xl">Featured projects</h2>
      </div>
      <a href="/en/projects" class="hidden text-sm font-semibold text-primary hover:underline md:inline-flex">View all</a>
    </div>
    <div class="grid gap-8 md:grid-cols-2 xl:grid-cols-3">
      {featuredProjects.map((project) => <ProjectCard project={project} locale="en" />)}
    </div>
  </section>
</Layout>
