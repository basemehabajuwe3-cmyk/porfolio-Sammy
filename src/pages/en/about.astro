---
import Layout from '../../layouts/Layout.astro';
import { experiences } from '../../data/experience';
import { skillGroups } from '../../data/skills';
---

<Layout
  locale="en"
  title="About | Sammy Habajuwe"
  description="Learn about Sammy Habajuwe, his experience, skills, and approach to building useful digital experiences."
>
  <section class="container mx-auto px-4 py-20 md:py-24">
    <div class="grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-primary">About</p>
        <h1 class="mt-3 text-4xl font-black text-foreground md:text-5xl">I build products that are easy to use.</h1>
        <p class="mt-6 text-lg leading-8 text-muted">
          I am a developer who cares about creating clear, useful, and lasting web experiences. My goal is to combine design, technical quality, and business value to help companies serve their customers better.
        </p>
        <p class="mt-4 text-lg leading-8 text-muted">
          I enjoy turning complex ideas into clear interfaces, working closely with product teams, and building solutions that genuinely help users.
        </p>
      </div>
      <div class="rounded-3xl border border-border bg-card p-8 shadow-sm">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-primary">Focus</p>
        <ul class="mt-6 space-y-4 text-muted">
          <li class="flex gap-3"><span class="mt-1 h-2.5 w-2.5 rounded-full bg-primary"></span> Accessible, high-performance web interfaces</li>
          <li class="flex gap-3"><span class="mt-1 h-2.5 w-2.5 rounded-full bg-primary"></span> Simple, maintainable, and scalable architecture</li>
          <li class="flex gap-3"><span class="mt-1 h-2.5 w-2.5 rounded-full bg-primary"></span> Product, UX, and engineering collaboration</li>
        </ul>
      </div>
    </div>

    <div class="mt-20">
      <div class="mb-8">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-primary">Experience</p>
        <h2 class="mt-3 text-3xl font-bold text-foreground md:text-4xl">Career</h2>
      </div>
      <div class="space-y-6">
        {experiences.map((job) => (
          <article class="rounded-2xl border border-border bg-card p-6 shadow-sm">
            <div class="flex flex-col gap-2 md:flex-row md:items-center md:justify-between">
              <div>
                <h3 class="text-xl font-semibold text-foreground">{job.titleEn ?? job.title}</h3>
                <p class="text-sm text-primary">{job.company}</p>
              </div>
              <span class="text-sm text-muted">{job.periodEn ?? job.period}</span>
            </div>
            <p class="mt-4 leading-7 text-muted">{job.descriptionEn ?? job.description}</p>
            {job.stack && (
              <div class="mt-4 flex flex-wrap gap-2">
                {job.stack.map((item) => (
                  <span class="rounded-full bg-primary/10 px-3 py-1 text-xs font-medium text-primary">{item}</span>
                ))}
              </div>
            )}
            {(job.missionEn ?? job.mission) && (
              <ul class="mt-4 list-inside list-disc space-y-1 text-sm text-muted">
                {(job.missionEn ?? job.mission)?.map((item) => <li>{item}</li>)}
              </ul>
            )}
          </article>
        ))}
      </div>
    </div>

    <div class="mt-20">
      <div class="mb-8">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-primary">Stack</p>
        <h2 class="mt-3 text-3xl font-bold text-foreground md:text-4xl">Technologies</h2>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        {skillGroups.map((group) => (
          <div class="rounded-2xl border border-border bg-card p-6 shadow-sm">
            <h3 class="mb-4 text-xl font-semibold text-foreground">{group.title === 'Outils & workflow' ? 'Tools & workflow' : group.title}</h3>
            <div class="flex flex-wrap gap-2">
              {group.items.map((item) => (
                <span class="rounded-full bg-background px-3 py-1.5 text-sm text-muted">{item}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
