---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
---

<Layout
  title="Projets | Sammy Habajuwe"
  description="Découvrez les projets web réalisés par Sammy Habajuwe : plateforme quiz, gestion de tâches et solutions de commande."
>
  <section class="container mx-auto px-4 py-20 md:py-24">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-primary">Portfolio</p>
      <h1 class="mt-3 text-4xl font-black text-foreground md:text-5xl">Mes projets</h1>
      <p class="mt-4 text-base leading-7 text-muted md:text-lg">
        Des interfaces simples, rapides et utiles pour des équipes qui veulent transformer des idées en produits concrets.
      </p>
    </div>

    <div class="mt-12 grid gap-8 md:grid-cols-2 xl:grid-cols-3">
      {projects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </section>
</Layout>
