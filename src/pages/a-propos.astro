---
import Layout from '../layouts/Layout.astro';
import { experiences } from '../data/experience';
import { skillGroups } from '../data/skills';
---

<Layout
  title="À propos | Sammy Habajuwe"
  description="En savoir plus sur Sammy Habajuwe, mon parcours, mes compétences et la manière dont je construis des expériences digitales utiles."
>
  <section class="container mx-auto px-4 py-20 md:py-24">
    <div class="grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-primary">À propos</p>
        <h1 class="mt-3 text-4xl font-black text-foreground md:text-5xl">Je crée des produits simples à utiliser.</h1>
        <p class="mt-6 text-lg leading-8 text-muted">
          Je suis un développeur passionné par la création d’expériences web claires, utiles et durables. Mon objectif est d’allier design, efficacité technique et valeur métier pour aider les entreprises à offrir de meilleurs services à leurs clients.
        </p>
        <p class="mt-4 text-lg leading-8 text-muted">
          J’aime transformer des idées complexes en interfaces lisibles, travailler en étroite collaboration avec les équipes produit et concevoir des solutions qui servent vraiment les utilisateurs.
        </p>
      </div>

      <div class="rounded-3xl border border-border bg-card p-8 shadow-sm">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-primary">Focus</p>
        <ul class="mt-6 space-y-4 text-muted">
          <li class="flex gap-3"><span class="mt-1 h-2.5 w-2.5 rounded-full bg-primary"></span> Interfaces web accessibles et performantes</li>
          <li class="flex gap-3"><span class="mt-1 h-2.5 w-2.5 rounded-full bg-primary"></span> Architecture simple, maintenable et évolutive</li>
          <li class="flex gap-3"><span class="mt-1 h-2.5 w-2.5 rounded-full bg-primary"></span> Collaboration produit, UX et code</li>
        </ul>
      </div>
    </div>

    <div class="mt-20">
      <div class="mb-8">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-primary">Expérience</p>
        <h2 class="mt-3 text-3xl font-bold text-foreground md:text-4xl">Parcours</h2>
      </div>

      <div class="space-y-6">
        {experiences.map((job) => (
          <article class="rounded-2xl border border-border bg-card p-6 shadow-sm">
            <div class="flex flex-col gap-2 md:flex-row md:items-center md:justify-between">
              <div>
                <h3 class="text-xl font-semibold text-foreground">{job.title}</h3>
                <p class="text-sm text-primary">{job.company}</p>
              </div>
              <span class="text-sm text-muted">{job.period}</span>
            </div>
            <p class="mt-4 leading-7 text-muted">{job.description}</p>
            {job.stack && (
              <div class="mt-4 flex flex-wrap gap-2">
                {job.stack.map((item) => (
                  <span class="rounded-full bg-primary/10 px-3 py-1 text-xs font-medium text-primary">{item}</span>
                ))}
              </div>
            )}
            {job.mission && (
              <ul class="mt-4 list-inside list-disc space-y-1 text-sm text-muted">
                {job.mission.map((item) => <li>{item}</li>)}
              </ul>
            )}
          </article>
        ))}
      </div>
    </div>

    <div class="mt-20">
      <div class="mb-8">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-primary">Stack</p>
        <h2 class="mt-3 text-3xl font-bold text-foreground md:text-4xl">Technologies</h2>
      </div>

      <div class="grid gap-6 md:grid-cols-3">
        {skillGroups.map((group) => (
          <div class="rounded-2xl border border-border bg-card p-6 shadow-sm">
            <h3 class="mb-4 text-xl font-semibold text-foreground">{group.title}</h3>
            <div class="flex flex-wrap gap-2">
              {group.items.map((item) => (
                <span class="rounded-full bg-background px-3 py-1.5 text-sm text-muted">{item}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
