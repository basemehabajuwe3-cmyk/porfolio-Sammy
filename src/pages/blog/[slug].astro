
---
import Layout from '../../layouts/Layout.astro';
import { blogPosts } from '../../data/blog';

export function getStaticPaths() {
  return blogPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;

const formatDate = (date: string) =>
  new Date(`${date}T00:00:00Z`).toLocaleDateString('fr-FR', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  });


---
<Layout title={`${post.title} | Blog | Sammy Habajuwe`} description={post.excerpt}>
  <article class="container mx-auto max-w-3xl px-4 py-16 md:py-24">
    <a href="/blog" class="text-sm font-semibold text-primary hover:underline">
      ← Retour au blog
    </a>

    <header class="mt-8 border-b border-border pb-8">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-primary">{post.category}</p>
      <h1 class="mt-3 text-4xl font-black leading-tight text-foreground md:text-5xl">{post.title}</h1>
      <p class="mt-5 text-lg leading-8 text-muted">{post.introduction}</p>
      <div class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted">
        <time datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time>
        <span aria-hidden="true">·</span>
        <span>{post.readingTime} de lecture</span>
      </div>
      <ul class="mt-5 flex flex-wrap gap-2" aria-label="Sujets de l’article">
        {post.tags.map((tag) => (
          <li class="rounded-full border border-border bg-card px-3 py-1 text-xs font-medium text-muted">
            {tag}
          </li>
        ))}
      </ul>
    </header>

    <div class="space-y-8 py-8">
      {post.sections.map((section) => (
        <section>
          <h2 class="text-2xl font-bold text-foreground">{section.heading}</h2>
          <div class="mt-3 space-y-4 text-base leading-8 text-muted">
            {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
          {section.bullets && (
            <ul class="mt-4 list-inside list-disc space-y-2 text-base leading-7 text-muted">
              {section.bullets.map((bullet) => <li>{bullet}</li>)}
            </ul>
          )}
        </section>
      ))}
    </div>

    <footer class="border-t border-border pt-8">
      <p class="text-muted">Un projet ou une question ? Parlons-en.</p>
      <a
        href="/contact"
        class="mt-4 inline-flex rounded-lg bg-primary px-5 py-3 text-sm font-semibold text-white transition hover:bg-primary/90"
      >
        Me contacter
      </a>
    </footer>
  </article>
</Layout>
