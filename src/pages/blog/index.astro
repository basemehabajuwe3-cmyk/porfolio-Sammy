
---
import Layout from '../../layouts/Layout.astro';
import { blogPosts } from '../../data/blog';

const sortedPosts = [...blogPosts].sort(
  (first, second) => Date.parse(second.publishedAt) - Date.parse(first.publishedAt),
);

const formatDate = (date: string) =>
  new Date(`${date}T00:00:00Z`).toLocaleDateString('fr-FR', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  });


---
<Layout
  title="Blog | Sammy Habajuwe"
  description="Articles de Sammy Habajuwe sur le développement web, l’accessibilité, la performance et la conception d’interfaces."
>
  <section class="container mx-auto px-4 py-20 md:py-24">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-primary">Notes et idées</p>
      <h1 class="mt-3 text-4xl font-black text-foreground md:text-5xl">Le blog</h1>
      <p class="mt-4 text-base leading-7 text-muted md:text-lg">
        Des conseils et réflexions autour du développement web, de l’accessibilité et de l’expérience utilisateur.
      </p>
    </div>

    <div class="mx-auto mt-12 grid max-w-5xl gap-6 md:grid-cols-2">
      {sortedPosts.map((post) => (
        <article class="flex h-full flex-col rounded-2xl border border-border bg-card p-6 shadow-sm">
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted">
            <span class="font-semibold text-primary">{post.category}</span>
            <span aria-hidden="true">·</span>
            <time datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time>
            <span aria-hidden="true">·</span>
            <span>{post.readingTime} de lecture</span>
          </div>
          <h2 class="mt-4 text-2xl font-bold text-foreground">
            <a class="transition-colors hover:text-primary" href={`/blog/${post.slug}`}>
              {post.title}
            </a>
          </h2>
          <p class="mt-3 flex-1 leading-7 text-muted">{post.excerpt}</p>
          <ul class="mt-5 flex flex-wrap gap-2" aria-label="Sujets de l’article">
            {post.tags.map((tag) => (
              <li class="rounded-full border border-border bg-background px-3 py-1 text-xs font-medium text-muted">
                {tag}
              </li>
            ))}
          </ul>
          <a
            class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-primary hover:underline"
            href={`/blog/${post.slug}`}
            aria-label={`Lire l’article : ${post.title}`}
          >
            Lire l’article <span aria-hidden="true">→</span>
          </a>
        </article>
      ))}
    </div>
  </section>
</Layout>
